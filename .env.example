# Copy to .env and fill in. Never commit the real .env.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002              # 4002 = Gateway paper, 4001 = Gateway live, 7497 = TWS paper, 7496 = TWS live
IBKR_CLIENT_ID=1
MODE=paper                  # paper | live — live also requires the --i-understand-the-risk CLI flag
LOG_LEVEL=INFO
MAX_POSITION_USD=500        # per-position notional cap
MAX_DAILY_LOSS_USD=200      # kill switch trips at this realized daily loss
